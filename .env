# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://boutique:boutique@127.0.0.1:33063/boutique?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> boutique ###
# Réseaux Docker / proxy de l'hôte autorisés à transmettre X-Forwarded-*
TRUSTED_PROXIES=private_ranges

# API SmartOF v2 (https://developers.smartof.fr). Valeurs réelles dans .env.local (jamais versionnées).
# SMARTOF_FAKE=1 : API simulée à partir de fixtures/smartof/ (dev, tests, préprod de démonstration).
SMARTOF_FAKE=1
# Jeu de données simulé : demo_api.json (catalogue de démonstration), fake_api.json (tests, cf. .env.test).
SMARTOF_FAKE_FIXTURES=demo_api.json
SMARTOF_BASE_URL=
SMARTOF_API_KEY=
# PROVISOIRE (QSO-3) : champ du produit SmartOF qui désigne les formations vendues sur la boutique.
SMARTOF_FILTRE_BOUTIQUE=custom_fields.custom_field_1=Oui
# PROVISOIRE (QSO-18) : champ du produit SmartOF qui désigne les formations éligibles au CPF.
SMARTOF_FILTRE_CPF=custom_fields.custom_field_2=Oui

# PROVISOIRE (QE-23) : données transmises dans les champs personnalisés SmartOF, « donnée:custom_field_N » séparés par des virgules.
# Apprenant : numeroSecu, situation. Commanditaire : numeroCommande, modePaiement, financement, identifiantFranceTravail,
# referencePaiement, opco, organisationProfessionnelle, remarque.
SMARTOF_CHAMPS_APPRENANT=
SMARTOF_CHAMPS_COMMANDITAIRE=

# PROVISOIRE (QE-6) : une session est réservable jusqu'à N jours avant son début (1 = la veille).
BOUTIQUE_JOURS_AVANT_SESSION=1
# Durée du blocage des places pendant le paiement CB (décision technique, ex-QE-7).
BOUTIQUE_BLOCAGE_PAIEMENT_MINUTES=30
# Chiffrement du n° de sécurité sociale : 32 octets en base64 (php -r "echo base64_encode(random_bytes(32));").
BOUTIQUE_CLE_CHIFFREMENT=

# Emails. PROVISOIRE (QE-22) : adresse prévenue à chaque réservation. Alertes techniques : vide = journal seulement.
BOUTIQUE_EMAIL_EXPEDITEUR=contact@coprotec.net
BOUTIQUE_EMAIL_SERVICE=contact@coprotec.net
BOUTIQUE_EMAIL_ALERTES=
# Affiché dans les instructions de virement (constante RIB de boutique-old).
BOUTIQUE_IBAN=

# Monetico (identifiants de boutique-old, dans .env.local). MONETICO_TEST=1 : serveur de test Monetico.
# MONETICO_SIMULE=1 : pas d'appel à Monetico, simulateur local (dev sans identifiants).
MONETICO_TPE=
MONETICO_CLE=
MONETICO_SOCIETE=
MONETICO_TEST=1
MONETICO_SIMULE=0
###< boutique ###
