{% extends 'base.html.twig' %}
{% from '_icones.html.twig' import icone %}

{% block title %}Réservation {{ commande.numero }}{% endblock %}

{% block hero %}{{ include('reservation/_entete.html.twig', {session: commande.session, etape: commande.statut.value == 'validee' ? 3 : 2}) }}{% endblock %}

{% block body %}
    {% set statut = commande.statut.value %}
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panneau">
                {% if statut == 'validee' %}
                    <p class="confirmation">{{ icone('valide') }} Réservation confirmée</p>
                    <p>Votre réservation porte le numéro <strong>{{ commande.numero }}</strong>. Un récapitulatif a été envoyé à <strong>{{ commande.contact.email }}</strong>.</p>

                    {% if commande.modePaiement.value == 'virement' %}
                        <div class="alerte-info">
                            <strong>Virement à effectuer : {{ commande.totalTtcCentimes|prix }}</strong><br>
                            IBAN : {{ iban ?: 'communiqué par le service formation' }} · BIC : CMCIFRPP<br>
                            Motif : {{ commande.numero }}
                        </div>
                    {% elseif commande.modePaiement.value == 'cheque' %}
                        <div class="alerte-info">
                            <strong>Chèque à envoyer sous 10 jours : {{ commande.totalTtcCentimes|prix }}</strong>, à l'ordre de COPROTEC, au 12, impasse Montgolfier, 68127 Sainte-Croix-en-Plaine. Référence au dos : {{ commande.numero }}.
                        </div>
                    {% elseif commande.modePaiement.value == 'financement' %}
                        <div class="alerte-info">Envoyez l'accord de prise en charge de France Travail dès sa réception à <a href="mailto:contact@coprotec.net">contact@coprotec.net</a>.</div>
                    {% endif %}
                    <p class="mb-0">Une convention de formation vous sera transmise pour finaliser l'inscription.</p>

                {% elseif statut == 'paiement_en_cours' and app.request.query.get('paiement') != 'erreur' %}
                    <p class="h5">Paiement en cours de confirmation…</p>
                    <p>Nous attendons la confirmation de la banque. Cette page se met à jour automatiquement.</p>
                    <meta http-equiv="refresh" content="5">
                    {% if commande.expireLe > date() %}<a href="{{ path('paiement_cb', {jeton: commande.jeton}) }}" class="btn btn-outline-primary">Revenir au paiement</a>{% endif %}

                {% elseif statut == 'paiement_en_cours' or statut == 'paiement_refuse' %}
                    <p class="h5 text-danger">Le paiement n'a pas abouti</p>
                    <p>Aucun montant n'a été débité.</p>
                    {% if statut == 'paiement_en_cours' and commande.expireLe > date() %}
                        <a href="{{ path('paiement_cb', {jeton: commande.jeton}) }}" class="btn btn-primary">Réessayer le paiement</a>
                    {% else %}
                        <a href="{{ path('formation', {slug: commande.session.formation.slug}) }}" class="btn btn-primary">Recommencer la réservation</a>
                    {% endif %}

                {% else %}
                    <p class="h5">Délai de paiement dépassé</p>
                    <p>Les places ont été remises en vente. Vous pouvez recommencer votre réservation.</p>
                    <a href="{{ path('formation', {slug: commande.session.formation.slug}) }}" class="btn btn-primary">Recommencer la réservation</a>
                {% endif %}
            </div>
        </div>

        <aside class="col-lg-4">
            <div class="resume">
                <p class="resume__titre">{{ commande.session.formation.intitule }}</p>
                <dl class="resume__lignes">
                    <div><dt>Participants</dt><dd>{{ commande.nbParticipants }}</dd></div>
                    <div><dt>Paiement</dt><dd>{{ commande.modePaiement.libelle }}</dd></div>
                    <div class="resume__total"><dt>Total HT</dt><dd>{{ commande.totalHtCentimes|prix }}</dd></div>
                    <div><dt>Total TTC</dt><dd>{{ commande.totalTtcCentimes|prix }}</dd></div>
                </dl>
                <ul class="liste-recap mb-0">
                    {% for p in commande.participants %}<li>{{ p.prenom }} {{ p.nom }}</li>{% endfor %}
                </ul>
            </div>
        </aside>
    </div>
{% endblock %}
