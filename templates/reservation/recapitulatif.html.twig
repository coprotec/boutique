{% extends 'base.html.twig' %}

{% block title %}Récapitulatif · {{ session.formation.intitule }}{% endblock %}

{% block hero %}{{ include('reservation/_entete.html.twig', {etape: 2}) }}{% endblock %}

{% block body %}
    <form method="post" action="{{ path('reservation_confirmer', {id: session.id}) }}" class="tunnel">
        <input type="hidden" name="_token" value="{{ csrf_token('reservation_confirmer') }}">

        <div class="tunnel__principal">
            <section class="etape">
                <header class="etape__entete">
                    <h2 class="etape__titre">Participant{{ demande.participants|length > 1 ? 's' }}</h2>
                    <p class="etape__aide"><a href="{{ path('reservation', {id: session.id}) }}">Modifier les informations</a></p>
                </header>
                <ul class="liste-recap">
                    {% for p in demande.participants %}
                        <li><strong>{{ p.prenom }} {{ p.nom|upper }}</strong> <span>né(e) le {{ p.dateNaissance|date('d/m/Y') }} · {{ p.situation }}</span></li>
                    {% endfor %}
                </ul>
                <dl class="grille-recap">
                    <div><dt>Entreprise</dt><dd>{{ demande.societe.raisonSociale }}<br><small>{{ demande.societe.adresse }}, {{ demande.societe.codePostal }} {{ demande.societe.ville }} · SIRET {{ demande.societe.normalizedSiret }}</small></dd></div>
                    <div><dt>Contact</dt><dd>{{ demande.contact.prenom }} {{ demande.contact.nom }}<br><small>{{ demande.contact.email }} · {{ demande.contact.telephone }}</small></dd></div>
                    <div><dt>Financement</dt><dd>{{ demande.financement.label }}{% if demande.normalizedFranceTravailId %} · identifiant {{ demande.normalizedFranceTravailId }}{% endif %}</dd></div>
                </dl>
            </section>

            <section class="etape">
                <header class="etape__entete"><h2 class="etape__titre">Mode de paiement</h2></header>
                <div class="choix choix--vertical" role="radiogroup" aria-label="Mode de paiement">
                    {% for mode in modes %}
                        <label class="choix__option">
                            <input type="radio" name="mode" value="{{ mode.value }}" required {{ modes|length == 1 ? 'checked' }}>
                            <span>
                                <strong>{{ mode.label }}</strong>
                                <small class="d-block text-body-secondary">
                                    {%- if mode.value == 'cb' %}Paiement sécurisé immédiat (Monetico). Vos places sont réservées pendant le paiement.
                                    {%- elseif mode.value == 'virement' %}Les coordonnées bancaires vous sont envoyées par email avec le récapitulatif.
                                    {%- elseif mode.value == 'cheque' %}L'adresse d'envoi du chèque vous est communiquée par email.
                                    {%- else %}La formation est prise en charge par France Travail : rien à régler en ligne.{% endif -%}
                                </small>
                            </span>
                        </label>
                    {% endfor %}
                </div>

                {# Texte repris de boutique-old (étape 3, « Convention de formation ») ; CGV : QE-16. #}
                <label class="consentement">
                    <input type="checkbox" name="consentement" value="1" required>
                    <span>J'accepte que mes coordonnées soient utilisées afin qu'une convention de formation me soit transmise pour finaliser l'inscription à la formation.</span>
                </label>
            </section>
        </div>

        <aside class="tunnel__resume">
            <div class="resume">
                <p class="resume__titre">{{ session.formation.intitule }}</p>
                <dl class="resume__lignes">
                    <div><dt>Prix par participant</dt><dd>{{ session.formation.prixHtCentimes|price }} HT</dd></div>
                    <div><dt>Participants</dt><dd>× {{ demande.participants|length }}</dd></div>
                    <div class="resume__total"><dt>Total HT</dt><dd>{{ totalHt|price }}</dd></div>
                    <div><dt>Total TTC</dt><dd>{{ totalTtc|price }}</dd></div>
                </dl>
                <button type="submit" class="btn btn-action btn-lg w-100">
                    Confirmer la réservation
                </button>
                <p class="resume__note">Les places sont vérifiées une dernière fois au moment de la confirmation.</p>
            </div>
        </aside>
    </form>
{% endblock %}
